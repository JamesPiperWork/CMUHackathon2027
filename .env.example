# Local defaults. All external sending is disabled. Copy to .env at repository root.
APP_MODE=demo
# For a labeled real-inbox demo, see EMAIL_DEMO_SETUP.md and .env.email-demo.example.
EMAIL_DELIVERY_MODE=simulated
EMAIL_DEMO_SEND_ENABLED=false
# Real-email testing on this computer can use matching loopback origins.
EMAIL_DEMO_LOCAL_ONLY=false
EMAIL_DEMO_RECIPIENTS=
EMAIL_RECEIPT_RELAY_SECRET=
PORT=3001
API_ORIGIN=http://localhost:3001
APP_ORIGIN=http://localhost:8081
HOST=0.0.0.0
DEMO_DATA_FILE=./data/demo.json
MATCH_DURATION_MINUTES=10080
# On a second device, use your computer's LAN IP for both origins.
EXPO_PUBLIC_API_ORIGIN=http://localhost:3001
EXPO_PUBLIC_MODE=demo

# Live identity + storage (MongoDB replica set required for transactions).
MONGODB_URI=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_WEB_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=
SESSION_SECRET=
TOKEN_SECRET=

# Optional content generation; no key means approved fixtures.
GEMINI_API_KEY=
GEMINI_MODEL=

# Explicit operator authorization and documented evidence; never provider verification.
LIVE_SEND_AUTHORIZED=false
ENABLE_LIVE_EMAIL=false
ENABLE_LIVE_SMS=false
ENABLE_LIVE_VOICE=false
EMAIL_PERMISSION_REFERENCE=
SMS_PERMISSION_REFERENCE=
VOICE_PERMISSION_REFERENCE=
EMAIL_REGISTRATION_REFERENCE=
SMS_REGISTRATION_REFERENCE=
VOICE_REGISTRATION_REFERENCE=
EMAIL_FORMAT_SUPPORTED=false
SMS_FORMAT_SUPPORTED=false
VOICE_FORMAT_SUPPORTED=false
EMAIL_DISCLOSURE_TEXT=
SMS_DISCLOSURE_TEXT=
VOICE_DISCLOSURE_TEXT=

# SMTP must explicitly permit the specific simulation format.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_VOICE_FROM=
TWILIO_CALLBACK_BASE=

# Licensed stock voice only. No recordings of players or voice cloning.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_PERMISSION_REFERENCE=
ELEVENLABS_STOCK_VOICE_CONFIRMED=false
AUDIO_CACHE_DIR=./data/audio
