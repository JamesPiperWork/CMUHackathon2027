# ---- Gemini (Google Generative AI) — the ONLY external service ----
GEMINI_API_KEY=your_gemini_api_key_here
# Model name lives here and ONLY here. One-line swappable.
GEMINI_MODEL=gemini-1.5-flash

# ---- Optional ----
# Base URL used in tracking links. Leave unset: links are built from each request's own
# origin, which just works on localhost and on Vercel preview/production URLs.
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
