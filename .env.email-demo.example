# Copy values into the repository-root .env. Never commit a populated secret file.
# This is a clearly labeled private real-email demo, separate from full live mode.
APP_MODE=demo
EMAIL_DELIVERY_MODE=smtp-demo
EMAIL_DEMO_SEND_ENABLED=false
EMAIL_DEMO_LOCAL_ONLY=false
# Immediate labeled testing: skips contact windows and daily pacing, keeps cast limits.
EMAIL_DEMO_IMMEDIATE=true
# Participants enter and verify their email during signup. Leave this blank.
# Optional: restrict signup to exact invited addresses, separated by commas.
EMAIL_DEMO_RECIPIENTS=
PORT=3001
HOST=0.0.0.0
API_ORIGIN=https://replace-api-host.invalid
APP_ORIGIN=https://replace-app-host.invalid
EXPO_PUBLIC_API_ORIGIN=https://replace-api-host.invalid
EXPO_PUBLIC_MODE=demo
DEMO_DATA_FILE=./data/email-demo.json
MATCH_DURATION_MINUTES=10080

# Generate two independent values locally; at least 32 random characters each.
SESSION_SECRET=REPLACE_WITH_RANDOM_SESSION_SECRET
TOKEN_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_TOKEN_SECRET
# Optional, only after integrating a delivery-evidence relay. Gmail does not send
# this webhook. Use a third independent random value, never a sample receipt.
EMAIL_RECEIPT_RELAY_SECRET=

# Dedicated Gmail account with 2-Step Verification and an eligible app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-dedicated-account@gmail.com
SMTP_PASS=REPLACE_WITH_APP_PASSWORD
SMTP_FROM=your-dedicated-account@gmail.com

# These stay disabled. smtp-demo has its own narrow sending flag above.
LIVE_SEND_AUTHORIZED=false
ENABLE_LIVE_EMAIL=false
ENABLE_LIVE_SMS=false
ENABLE_LIVE_VOICE=false

# Optional: prepared fallback bait is available without a Gemini key.
GEMINI_API_KEY=
GEMINI_MODEL=
