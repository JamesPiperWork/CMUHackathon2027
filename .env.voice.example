# Add the needed values to the existing .env; do not replace the Gmail setup.
# Store the secret key locally, never in EXPO_PUBLIC_* or chat.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STOCK_VOICE_CONFIRMED=false
AUDIO_CACHE_DIR=data/audio

# Optional real-phone setup. Leave disabled for browser audio preview.
# twilio-demo requires APP_MODE=demo and EMAIL_DELIVERY_MODE=smtp-demo.
PHONE_DELIVERY_MODE=simulated
PHONE_DEMO_SEND_ENABLED=false
PHONE_DEMO_VERIFY_ENABLED=false
ENABLE_PHONE_DEMO_SMS=false
ENABLE_PHONE_DEMO_VOICE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VOICE_FROM=
TWILIO_SMS_FROM=
TWILIO_CALLBACK_BASE=
# Explicitly true for trial, false for an upgraded account.
TWILIO_TRIAL_MODE=true
# Trial destinations verified in Twilio Console, in +1... format.
TWILIO_TRIAL_RECIPIENTS=
# Reference to approved A2P 10DLC or toll-free verification, required for bait SMS.
SMS_REGISTRATION_REFERENCE=
